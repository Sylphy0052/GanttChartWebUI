# ============================================================================
# GanttChart WebUI - Crontab設定例
# ============================================================================
# 説明: GanttChart WebUIのバックアップ自動化用crontab設定
# 
# 設定方法:
#   1. このファイルを編集して環境に合わせてパスを調整
#   2. crontab -e で編集モードを開く
#   3. 以下の設定をコピー&ペーストして保存
# 
# 注意事項:
#   - パスは絶対パスで指定
#   - 実行ユーザーに適切な権限が必要
#   - ログローテーションの設定も併せて検討
#   - テスト実行でスケジュールを確認
# 
# 確認方法:
#   crontab -l でスケジュール確認
#   /var/log/cron でcron実行ログ確認
#   /var/log/ganttchart-backup.log でバックアップログ確認
# ============================================================================

# 環境変数の設定
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
SHELL=/bin/bash
MAILTO=admin@ganttchart.local

# GanttChart WebUI プロジェクトのパス（環境に合わせて変更）
GANTTCHART_HOME=/opt/ganttchart
BACKUP_SCRIPT=$GANTTCHART_HOME/scripts/backup-database.sh
MIGRATION_SCRIPT=$GANTTCHART_HOME/scripts/migration-helper.sh

# ============================================================================
# 日次バックアップスケジュール
# ============================================================================

# 毎日午前2時に日次バックアップを実行
# - 一般的にシステム利用が少ない時間帯
# - 30日間保持
0 2 * * * $BACKUP_SCRIPT -t daily -v 2>&1 | logger -t ganttchart-backup-daily

# 毎日午前2時30分にデータ整合性チェック（月曜日のみ詳細チェック）
30 2 * * 1 $MIGRATION_SCRIPT validate-data -v 2>&1 | logger -t ganttchart-validate
30 2 * * 2-7 $MIGRATION_SCRIPT validate-data 2>&1 | logger -t ganttchart-validate

# ============================================================================
# 週次バックアップスケジュール
# ============================================================================

# 毎週日曜日午前1時に週次バックアップを実行
# - 週末の低負荷時間帯
# - 12週間保持
# - 暗号化を有効化
0 1 * * 0 $BACKUP_SCRIPT -t weekly -e -v 2>&1 | logger -t ganttchart-backup-weekly

# 毎週日曜日午前1時30分にデータベース最適化
30 1 * * 0 $MIGRATION_SCRIPT optimize-db -v 2>&1 | logger -t ganttchart-optimize

# ============================================================================
# 月次バックアップスケジュール
# ============================================================================

# 毎月1日午前0時30分に月次バックアップを実行
# - 月初の低負荷時間帯
# - 12ヶ月保持
# - 暗号化を有効化
30 0 1 * * $BACKUP_SCRIPT -t monthly -e -v 2>&1 | logger -t ganttchart-backup-monthly

# 毎月1日午前0時45分にデータクリーンアップ
45 0 1 * * $MIGRATION_SCRIPT cleanup-data -v 2>&1 | logger -t ganttchart-cleanup

# ============================================================================
# 年次バックアップスケジュール
# ============================================================================

# 毎年1月1日午前0時に年次バックアップを実行
# - 年始の低負荷時間帯
# - 5年間保持
# - 暗号化を有効化
0 0 1 1 * $BACKUP_SCRIPT -t yearly -e -v 2>&1 | logger -t ganttchart-backup-yearly

# ============================================================================
# メンテナンススケジュール
# ============================================================================

# 毎週水曜日午前3時にシステム依存関係チェック
0 3 * * 3 $MIGRATION_SCRIPT check-dependencies 2>&1 | logger -t ganttchart-deps

# 毎日午前4時にバックアップディスク容量チェック
0 4 * * * df -h /var/backups/ganttchart | grep -v Filesystem | awk '{print $5}' | sed 's/%//' | awk '{if($1 > 80) print "WARNING: Backup disk usage over 80%: " $1 "%"}' | logger -t ganttchart-disk

# 毎週金曜日午前3時30分に古いログファイルのクリーンアップ
30 3 * * 5 find /var/log -name "ganttchart-*.log" -mtime +30 -delete 2>&1 | logger -t ganttchart-log-cleanup

# ============================================================================
# 開発環境用スケジュール（本番環境では不要）
# ============================================================================

# 平日の営業時間外にテストバックアップを実行（開発環境のみ）
# 0 22 * * 1-5 $BACKUP_SCRIPT -t daily -n -v 2>&1 | logger -t ganttchart-test-backup

# ============================================================================
# ステージング環境用スケジュール
# ============================================================================

# 本番環境のデータをステージング環境に同期（毎週土曜日午前6時）
# 本番環境からのデータ移行のテスト用
# 0 6 * * 6 $MIGRATION_SCRIPT migrate-env -s production -t staging -f 2>&1 | logger -t ganttchart-prod-to-staging

# ============================================================================
# アラート・監視スケジュール
# ============================================================================

# 毎日午前9時にバックアップ状況をチェックして管理者に通知
0 9 * * * [ -f /var/log/ganttchart-backup.log ] && tail -n 50 /var/log/ganttchart-backup.log | grep -E "(ERROR|WARN|SUCCESS)" | mail -s "GanttChart Backup Status" admin@ganttchart.local

# 毎時間、重要なサービスの稼働状況をチェック
0 * * * * docker ps --filter "name=postgres" --format "table {{.Names}}\t{{.Status}}" | grep -v "Up" | xargs -r -I {} echo "PostgreSQL container issue: {}" | logger -t ganttchart-health

# ============================================================================
# 緊急時用スケジュール（災害対策）
# ============================================================================

# 毎日午前5時に外部ストレージへのバックアップコピー（AWS S3、GCS等）
# 5 5 * * * aws s3 sync /var/backups/ganttchart/ s3://ganttchart-disaster-backup/ --delete 2>&1 | logger -t ganttchart-s3-sync

# ============================================================================
# パフォーマンス監視スケジュール
# ============================================================================

# 毎時間、データベースのパフォーマンス統計を収集
0 * * * * docker exec postgres_container psql -U gantt_user -d gantt_db -c "SELECT schemaname,tablename,n_tup_ins,n_tup_upd,n_tup_del FROM pg_stat_user_tables;" 2>/dev/null | logger -t ganttchart-perf

# ============================================================================
# テスト・検証スケジュール
# ============================================================================

# 毎月第1土曜日午前10時にバックアップ・リストアの完全テスト
0 10 1-7 * 6 [ $(date +\%u) -eq 6 ] && $BACKUP_SCRIPT -n -v && $MIGRATION_SCRIPT analyze-migration -s production -t staging -d 2>&1 | logger -t ganttchart-full-test

# ============================================================================
# ログローテーション用スケジュール
# ============================================================================

# 毎日午前6時にカスタムログローテーション実行
0 6 * * * /usr/sbin/logrotate -f /etc/logrotate.d/ganttchart 2>&1 | logger -t ganttchart-logrotate

# ============================================================================
# 設定例のバリエーション
# ============================================================================

# 高頻度バックアップ（重要なシステム用）
# 毎4時間ごとにインクリメンタルバックアップ
# 0 */4 * * * $BACKUP_SCRIPT -t incremental 2>&1 | logger -t ganttchart-incremental

# 低頻度バックアップ（テスト環境用）
# 毎週金曜日のみバックアップ
# 0 2 * * 5 $BACKUP_SCRIPT -t weekly 2>&1 | logger -t ganttchart-test-backup

# ============================================================================
# カスタマイズ可能な設定項目
# ============================================================================

# 環境変数ファイルの読み込み（カスタム設定用）
# source /etc/ganttchart/backup.env

# 複数環境での設定分岐例
# ENVIRONMENT=$(hostname | cut -d'-' -f2)
# case $ENVIRONMENT in
#   "prod")   BACKUP_SCHEDULE="0 1 * * *" ;;
#   "stage")  BACKUP_SCHEDULE="0 2 * * *" ;;
#   "dev")    BACKUP_SCHEDULE="0 3 * * *" ;;
# esac

# ============================================================================
# 注意事項とベストプラクティス
# ============================================================================

# 1. タイムゾーンの確認
#    - システムのタイムゾーンが適切に設定されているか確認
#    - UTC vs JST の違いに注意

# 2. リソース競合の回避
#    - 複数のバックアップジョブが同時実行されないよう時間をずらす
#    - システムの高負荷時間帯を避ける

# 3. エラーハンドリング
#    - 失敗時の通知設定
#    - ログの適切な保存と確認

# 4. セキュリティ
#    - 実行ユーザーの最小権限
#    - 機密情報の環境変数化

# 5. テスト
#    - 本番適用前の十分なテスト
#    - リストア手順の定期的な確認

# ============================================================================
# トラブルシューティング用コマンド
# ============================================================================

# crontabの構文チェック
# crontab -l | crontab -T

# 特定ジョブの手動実行テスト
# $BACKUP_SCRIPT -n -v

# cron実行履歴の確認
# grep "ganttchart" /var/log/cron | tail -20

# システムリソース使用量の確認
# top -p $(pgrep -f ganttchart) | head -20