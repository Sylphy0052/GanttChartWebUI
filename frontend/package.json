{
  "name": "gantt-chart-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:run:headless": "cypress run --headless",
    "cypress:run:docker": "cypress run --config-file cypress.config.docker.ts --browser chrome --headless",
    "test:e2e": "cypress run --spec 'cypress/e2e/**/*.cy.ts'",
    "test:e2e:open": "cypress open --e2e",
    "test:e2e:docker": "../scripts/run-e2e-tests.sh",
    "test:e2e:docker:spec": "../scripts/run-e2e-tests.sh spec",
    "test:e2e:docker:reports": "../scripts/run-e2e-tests.sh reports",
    "test:e2e:docker:cleanup": "../scripts/run-e2e-tests.sh cleanup",
    "test:cross-browser": "npm run test:cross-browser:chrome && npm run test:cross-browser:firefox && npm run test:cross-browser:edge",
    "test:cross-browser:chrome": "cypress run --browser chrome --spec 'cypress/e2e/cross-browser.cy.ts'",
    "test:cross-browser:firefox": "cypress run --browser firefox --spec 'cypress/e2e/cross-browser.cy.ts'",
    "test:cross-browser:edge": "cypress run --browser edge --spec 'cypress/e2e/cross-browser.cy.ts'",
    "test:cross-browser:safari": "cypress run --browser webkit --spec 'cypress/e2e/cross-browser.cy.ts'",
    "test:cross-browser:open": "cypress open --e2e --spec 'cypress/e2e/cross-browser.cy.ts'",
    "test:responsive": "npm run test:responsive:mobile && npm run test:responsive:tablet && npm run test:responsive:desktop",
    "test:responsive:mobile": "cypress run --config viewportWidth=375,viewportHeight=667 --spec 'cypress/e2e/cross-browser.cy.ts'",
    "test:responsive:tablet": "cypress run --config viewportWidth=768,viewportHeight=1024 --spec 'cypress/e2e/cross-browser.cy.ts'",
    "test:responsive:desktop": "cypress run --config viewportWidth=1920,viewportHeight=1080 --spec 'cypress/e2e/cross-browser.cy.ts'",
    "test:browser-specific": "npm run test:browser-specific:chrome && npm run test:browser-specific:firefox",
    "test:browser-specific:chrome": "cypress run --browser chrome --spec 'cypress/e2e/cross-browser.cy.ts' --env browserName=chrome",
    "test:browser-specific:firefox": "cypress run --browser firefox --spec 'cypress/e2e/cross-browser.cy.ts' --env browserName=firefox",
    "test:performance": "cypress run --spec 'cypress/e2e/performance.cy.ts'",
    "test:performance:open": "cypress open --e2e --spec 'cypress/e2e/performance.cy.ts'",
    "test:performance:docker": "cypress run --config-file cypress.config.docker.ts --spec 'cypress/e2e/performance.cy.ts' --browser chrome --headless",
    "test:performance:small": "cypress run --spec 'cypress/e2e/performance.cy.ts' --env dataSize=small",
    "test:performance:medium": "cypress run --spec 'cypress/e2e/performance.cy.ts' --env dataSize=medium",
    "test:performance:large": "cypress run --spec 'cypress/e2e/performance.cy.ts' --env dataSize=large",
    "test:performance:all-sizes": "npm run test:performance:small && npm run test:performance:medium && npm run test:performance:large",
    "test:performance:ci": "cypress run --spec 'cypress/e2e/performance.cy.ts' --browser chrome --headless --reporter json --reporter-options 'outputFile=cypress/reports/performance-results.json'",
    "test:performance:baseline": "cypress run --spec 'cypress/e2e/performance.cy.ts' --env mode=baseline",
    "test:performance:regression": "cypress run --spec 'cypress/e2e/performance.cy.ts' --env mode=regression",
    "version:check": "echo \"Frontend Version: $(node -p 'require(\"./package.json\").version')\"",
    "version:bump:patch": "npm version patch --no-git-tag-version",
    "version:bump:minor": "npm version minor --no-git-tag-version",
    "version:bump:major": "npm version major --no-git-tag-version"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@heroicons/react": "^2.0.18",
    "@next/font": "^14.0.3",
    "ag-grid-community": "^31.1.1",
    "ag-grid-react": "^31.1.1",
    "date-fns": "^2.30.0",
    "date-fns-tz": "^2.0.0",
    "framer-motion": "^10.16.16",
    "lucide-react": "^0.294.0",
    "next": "^15.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "recharts": "^2.8.0",
    "socket.io-client": "^4.7.4",
    "tailwind-merge": "^2.2.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "cypress": "^15.1.0",
    "eslint": "^8",
    "eslint-config-next": "15.0.3",
    "postcss": "^8",
    "tailwindcss": "^4.0.0",
    "typescript": "^5"
  }
}