# Database Configuration
POSTGRES_USER=gantt_user
POSTGRES_PASSWORD=gantt_pass
POSTGRES_DB=gantt_db
DATABASE_URL=postgresql://gantt_user:gantt_pass@postgres:5432/gantt_db?schema=public

# Application Configuration
NODE_ENV=production
BACKEND_PORT=3001
FRONTEND_PORT=3000
NGINX_PORT=8080

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# Security Configuration
# Authentication Type: 'basic' | 'jwt' | 'none'
AUTH_TYPE=jwt

# Basic Authentication (if AUTH_TYPE=basic)
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=change-this-secure-password

# JWT Configuration (if AUTH_TYPE=jwt)
# IMPORTANT: Generate a strong secret key for production
# Example: openssl rand -base64 32
JWT_SECRET=change-this-to-a-strong-secret-key-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_THRESHOLD=300

# CORS Configuration for WebSocket
# Comma-separated list of allowed origins for production
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com