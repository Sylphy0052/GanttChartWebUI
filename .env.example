# Database Configuration
POSTGRES_USER=gantt_user
POSTGRES_PASSWORD=gantt_pass
POSTGRES_DB=gantt_db
DATABASE_URL=postgresql://gantt_user:gantt_pass@postgres:5432/gantt_db?schema=public

# Application Configuration
NODE_ENV=production
BACKEND_PORT=3001
FRONTEND_PORT=3000
NGINX_PORT=8080

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws