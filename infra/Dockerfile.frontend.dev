FROM node:20-alpine

# Check https://github.com/nodejs/docker-node/tree/b4117f9333da4138b03a546ec926ef50a31506c3#nodealpine to understand why libc6-compat might be needed.
# Cypress dependencies for E2E testing (Alpine Linux packages)
# See: https://docs.cypress.io/guides/continuous-integration/introduction#Dependencies
RUN apk add --no-cache \
    libc6-compat \
    xvfb \
    gtk+3.0 \
    gtk+3.0-dev \
    libnotify \
    nss \
    alsa-lib \
    xauth \
    dbus \
    font-noto-emoji \
    eudev \
    eudev-dev \
    gcompat \
    libstdc++ \
    bash \
    ca-certificates \
    chromium \
    chromium-chromedriver \
    firefox \
    wget

WORKDIR /app

# Install dependencies
COPY package.json yarn.lock* package-lock.json* pnpm-lock.yaml* ./

RUN \
  if [ -f yarn.lock ]; then yarn --frozen-lockfile; \
  elif [ -f package-lock.json ]; then npm ci; \
  elif [ -f pnpm-lock.yaml ]; then corepack enable pnpm && pnpm i --frozen-lockfile; \
  else echo "Lockfile not found." && exit 1; \
  fi

# Next.js collects completely anonymous telemetry data about general usage.
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=development

# Cypress environment variables for Alpine Linux
ENV CYPRESS_CACHE_FOLDER=/root/.cache/Cypress
ENV DISPLAY=:0
ENV CHROME_BIN=/usr/bin/chromium-browser
ENV CHROME_PATH=/usr/bin/chromium-browser

EXPOSE 3000

# 開発モードで起動（ボリュームマウントされたコードを使用）
CMD ["npm", "run", "dev"]