# ====================
# GanttChart WebUI - Backend Production Dockerfile
# ====================
# Production-optimized build with multi-stage process
# Features: Alpine Linux, non-root user, security hardening, build cache optimization

FROM node:20-alpine AS base

# Install system dependencies required for production
RUN apk add --no-cache \
    openssl \
    openssl-dev \
    curl \
    dumb-init \
    && rm -rf /var/cache/apk/* \
    && rm -rf /tmp/* \
    && addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 --ingroup nodejs nestjs

WORKDIR /app

# ====================
# Dependencies Stage
# ====================
FROM base AS deps

# Copy package files and prisma schema for better layer caching
COPY package*.json ./
COPY prisma ./prisma/

# Install production dependencies only
RUN npm ci --only=production --ignore-scripts \
    && npm cache clean --force

# Generate Prisma client for production
RUN npx prisma generate

# ====================
# Build Dependencies Stage
# ====================
FROM base AS build-deps

# Copy package files
COPY package*.json ./
COPY prisma ./prisma/

# Install all dependencies for building (including dev dependencies)
RUN npm ci --ignore-scripts \
    && npm cache clean --force

# Generate Prisma client
RUN npx prisma generate

# ====================
# Builder Stage
# ====================
FROM base AS builder

# Copy all dependencies from build-deps stage
COPY --from=build-deps /app/node_modules ./node_modules
COPY --from=build-deps /app/prisma ./prisma/

# Copy source code
COPY . .

# Build the application with production optimizations
ENV NODE_ENV=production
RUN npm run build \
    && rm -rf src test *.json *.md \
    && npm prune --production

# ====================
# Production Stage
# ====================
FROM base AS production

# Copy production dependencies from deps stage
COPY --from=deps --chown=nestjs:nodejs /app/node_modules ./node_modules
COPY --from=deps --chown=nestjs:nodejs /app/prisma ./prisma

# Copy built application from builder stage
COPY --from=builder --chown=nestjs:nodejs /app/dist ./dist
COPY --from=builder --chown=nestjs:nodejs /app/package*.json ./

# Create necessary directories with proper permissions
RUN mkdir -p /app/uploads /app/logs \
    && chown -R nestjs:nodejs /app \
    && chmod 755 /app/uploads /app/logs

# Switch to non-root user
USER nestjs

# Set environment variables for production
ENV NODE_ENV=production
ENV PORT=3002
ENV NODE_OPTIONS="--max-old-space-size=2048 --enable-source-maps=false"

# Expose port
EXPOSE 3002

# Add comprehensive health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:3002/health || exit 1

# Use dumb-init for proper signal handling and start the application
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "dist/main.js"]

# ====================
# Image Metadata
# ====================
LABEL maintainer="GanttChart WebUI Team"
LABEL description="GanttChart WebUI Backend - Production Optimized Multi-stage Build"
LABEL version="1.0.0"
LABEL org.opencontainers.image.title="GanttChart Backend Production"
LABEL org.opencontainers.image.description="NestJS + Prisma + TypeScript backend optimized for production with enhanced security"
LABEL org.opencontainers.image.vendor="GanttChart WebUI"
LABEL org.opencontainers.image.licenses="MIT"