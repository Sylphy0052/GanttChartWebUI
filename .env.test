# ====================
# GanttChart WebUI - Production Test Environment Configuration
# ====================

# ====================
# Database Configuration
# ====================
POSTGRES_USER=gantt_prod_user
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD_123
POSTGRES_DB=gantt_production
DATABASE_URL="postgresql://gantt_prod_user:CHANGE_ME_SECURE_PASSWORD_123@postgres:5432/gantt_production?schema=public&connection_limit=20&pool_timeout=20"

# ====================
# Node.js Environment
# ====================
NODE_ENV=production

# ====================
# Application Ports
# ====================
BACKEND_PORT=3002
NGINX_PORT=80
NGINX_HTTPS_PORT=443

# ====================
# Frontend Configuration (Local Testing)
# ====================
NEXT_PUBLIC_API_URL=http://localhost
NEXT_PUBLIC_WS_URL=ws://localhost

# ====================
# Authentication & Security
# ====================
AUTH_TYPE=password
JWT_SECRET=test_jwt_secret_256_bit_minimum_length_required_for_security
SESSION_SECRET=test_session_secret_256_bit_minimum_length_required

# ====================
# Performance & Resource Settings
# ====================
NODE_MAX_OLD_SPACE_SIZE=2048
DB_CONNECTION_POOL_MIN=5
DB_CONNECTION_POOL_MAX=20
CACHE_TTL=3600

# ====================
# Logging & Monitoring
# ====================
LOG_LEVEL=info
LOG_MAX_FILES=14
LOG_MAX_SIZE=100m
METRICS_ENABLED=true
HEALTH_CHECK_INTERVAL=30

# ====================
# File Upload & Storage
# ====================
MAX_FILE_SIZE=10
ALLOWED_FILE_EXTENSIONS=jpg,jpeg,png,gif,pdf,doc,docx

# ====================
# Rate Limiting
# ====================
RATE_LIMIT_RPM=1000
WS_CONNECTION_LIMIT=100

# ====================
# Backup & Maintenance
# ====================
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30

# ====================
# SSL/TLS Configuration (Test)
# ====================
SSL_CERT_PATH=/etc/ssl/certs/test-domain.crt
SSL_KEY_PATH=/etc/ssl/private/test-domain.key
HSTS_MAX_AGE=31536000